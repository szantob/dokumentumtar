---
export const prerender = false;
import BaseHead from '../components/BaseHead.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="hu">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <div class="brand">
          <span class="site-title">Dokumentumtár</span>
          <span class="site-subtitle">Nyilvános dokumentumtár</span>
        </div>
        <a href="/admin" class="admin-btn">Admin felület</a>
      </div>
    </header>

    <main class="page-shell">
      <div class="filter-bar">
        <input type="search" id="searchInput" placeholder="Keresés cím szerint…" class="search-input" />
        <div id="tagFilters" class="tag-filters"></div>
      </div>

      <div id="loadingState" class="state-box">Témák betöltése…</div>
      <div id="errorState" class="state-box state-error hidden">Hiba történt a dokumentumok betöltésekor.</div>
      <div id="emptyState" class="state-box hidden">
        <div class="empty-icon">📁</div>
        <p>Nincs megjelenítendő téma</p>
      </div>
      <section id="topicsContainer" class="topics-container"></section>
    </main>

    <footer class="site-footer">
      <p>Dokumentumtár — Nyilvános dokumentumtár</p>
    </footer>
  </body>
</html>

<script>
  interface Tag {
    id: number;
    name: string;
    slug: string;
    color: string | null;
    sort_order: number;
  }

  interface DocumentType {
    id: number;
    name: string;
    slug: string;
    color: string | null;
    sort_order: number;
  }

  interface Document {
    id: number;
    topic_id: number;
    parent_id: number | null;
    document_type_id: number;
    title: string;
    reference_no: string | null;
    r2_key: string;
    file_name: string;
    file_size: number;
    mime_type: string;
    sort_order: number;
    is_active: number;
    created_at: string;
    document_type?: DocumentType;
    attachments?: Document[];
  }

  interface Topic {
    id: number;
    title: string;
    event_date: string | null;
    document_count: number | null;
    sort_order: number;
    is_public: number;
    created_at: string;
    updated_at: string;
    tags?: Tag[];
    documents?: Document[];
  }

  const loadingStateEl = document.getElementById('loadingState') as HTMLDivElement;
  const errorStateEl = document.getElementById('errorState') as HTMLDivElement;
  const emptyStateEl = document.getElementById('emptyState') as HTMLDivElement;
  const topicsContainerEl = document.getElementById('topicsContainer') as HTMLElement;
  const tagFiltersEl = document.getElementById('tagFilters') as HTMLDivElement;
  const searchInputEl = document.getElementById('searchInput') as HTMLInputElement;

  let topics: Topic[] = [];
  let activeTagSlug = '';

  function escapeHtml(value: string): string {
    return value
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function formatDate(value: string | null): string {
    if (!value) return 'Nincs esemény dátum';
    return new Date(value).toLocaleString('hu-HU', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
    });
  }

  function formatSize(bytes: number): string {
    if (bytes < 1024) return `${bytes} B`;
    if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
    return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
  }

  function matchesSearch(topic: Topic, searchValue: string): boolean {
    if (!searchValue) {
      return true;
    }

    return (topic.documents ?? []).some((document) => {
      const inDocument = document.title.toLowerCase().includes(searchValue);
      const inAttachment = (document.attachments ?? []).some((attachment) => attachment.title.toLowerCase().includes(searchValue));
      return inDocument || inAttachment;
    });
  }

  function renderDocumentList(documents: Document[], level = 0): string {
    if (documents.length === 0) {
      return '<p class="no-docs">Ehhez a témához jelenleg nincs aktív dokumentum.</p>';
    }

    return documents.map((document, idx) => {
      const attachments = document.attachments && document.attachments.length > 0
        ? `<div class="attachment-list">${renderDocumentList(document.attachments, level + 1)}</div>`
        : '';
      const downloadPath = `/api/download/${document.r2_key.split('/').map(encodeURIComponent).join('/')}`;
      const badgeColor = document.document_type?.color ?? '#475569';
      const typeBadge = `<span class="doc-type-badge" style="--badge-color:${escapeHtml(badgeColor)}">${escapeHtml(document.document_type?.name ?? 'Melléklet')}</span>`;
      const rowClass = `doc-row${level === 0 && idx % 2 !== 0 ? ' row-alt' : ''}${level > 0 ? ' attachment-row' : ''}`;
      return `<div class="doc-item${level > 0 ? ' attachment-item' : ''}">
        <div class="${rowClass}">
          ${typeBadge}
          <a href="${downloadPath}" class="doc-title-link" download>${escapeHtml(document.title)}</a>
          <span class="doc-size">${escapeHtml(formatSize(document.file_size))}</span>
          <a href="${downloadPath}" class="pdf-btn" download>PDF</a>
        </div>
        ${attachments}
      </div>`;
    }).join('');
  }

  function renderTagFilters(): void {
    const tagsBySlug = new Map<string, Tag>();
    topics.forEach((topic) => {
      (topic.tags ?? []).forEach((tag) => tagsBySlug.set(tag.slug, tag));
    });

    const tags = Array.from(tagsBySlug.values()).sort((left, right) => left.sort_order - right.sort_order || left.name.localeCompare(right.name, 'hu'));

    tagFiltersEl.innerHTML = [
      `<button type="button" class="filter-pill${activeTagSlug === '' ? ' active' : ''}" data-tag="">Összes</button>`,
      ...tags.map((tag) => {
        const color = escapeHtml(tag.color ?? '#475569');
        return `<button type="button" class="filter-pill${activeTagSlug === tag.slug ? ' active' : ''}" data-tag="${escapeHtml(tag.slug)}" style="--tag-color:${color}">${escapeHtml(tag.name)}</button>`;
      }),
    ].join('');

    tagFiltersEl.querySelectorAll<HTMLButtonElement>('.filter-pill').forEach((button) => {
      button.addEventListener('click', () => {
        activeTagSlug = button.dataset.tag ?? '';
        renderTagFilters();
        renderTopics();
      });
    });
  }

  function renderTopics(): void {
    const searchValue = searchInputEl.value.trim().toLowerCase();
    const filteredTopics = topics.filter((topic) => {
      const matchesTag = !activeTagSlug || (topic.tags ?? []).some((tag) => tag.slug === activeTagSlug);
      return matchesTag && matchesSearch(topic, searchValue);
    });

    emptyStateEl.classList.toggle('hidden', filteredTopics.length > 0);
    topicsContainerEl.innerHTML = filteredTopics.map((topic) => {
      const tagBadges = (topic.tags ?? []).map((tag) => {
        const color = escapeHtml(tag.color ?? '#475569');
        return `<span class="tag-pill" style="--tag-color:${color}">${escapeHtml(tag.name)}</span>`;
      }).join('');
      const docCount = topic.document_count ?? topic.documents?.length ?? 0;
      return `<div class="topic-section" data-open="true">
        <div class="topic-header">
          <div class="topic-header-left">
            <h2 class="topic-title">${escapeHtml(topic.title)}</h2>
            <div class="topic-meta-row">
              <div class="tag-row">${tagBadges}</div>
              <span class="topic-date">${escapeHtml(formatDate(topic.event_date))}</span>
            </div>
          </div>
          <div class="topic-header-right">
            <span class="doc-count-badge">${docCount} dokumentum</span>
            <svg class="collapse-icon" viewBox="0 0 20 20" fill="currentColor" width="16" height="16" aria-hidden="true"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
          </div>
        </div>
        <div class="topic-content">
          ${renderDocumentList(topic.documents ?? [])}
        </div>
      </div>`;
    }).join('');

    topicsContainerEl.querySelectorAll<HTMLElement>('.topic-header').forEach((header) => {
      header.addEventListener('click', () => {
        const section = header.closest<HTMLElement>('.topic-section');
        if (section) {
          section.dataset.open = section.dataset.open === 'true' ? 'false' : 'true';
        }
      });
    });
  }

  async function fetchJson<T>(url: string): Promise<T> {
    const response = await fetch(url);
    if (!response.ok) {
      throw new Error(`HTTP ${response.status}`);
    }
    return response.json() as Promise<T>;
  }

  async function loadTopics(): Promise<void> {
    const topicSummaries = await fetchJson<Topic[]>('/api/topics');
    topics = await Promise.all(
      topicSummaries.map((topic) => fetchJson<Topic>(`/api/topics/${topic.id}`)),
    );
    renderTagFilters();
    renderTopics();
    loadingStateEl.classList.add('hidden');
  }

  searchInputEl.addEventListener('input', () => {
    renderTopics();
  });

  void loadTopics().catch(() => {
    loadingStateEl.classList.add('hidden');
    errorStateEl.classList.remove('hidden');
  });
</script>

<style>
  :root {
    --blue: #1a56db;
    --blue-hover: #1648c0;
    --blue-tint: #f0f4ff;
    --text: #1a1a2e;
    --muted: #6b7280;
    --border: #e5e7eb;
    --border-light: #f3f4f6;
    --bg-alt: #f9fafb;
    --bg-footer: #f7f6f2;
    --shadow-card: 0 1px 4px rgba(0, 0, 0, 0.08);
    --radius: 8px;
    --radius-sm: 4px;
    --radius-pill: 999px;
  }

  :global(body) {
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    color: var(--text);
    background: #fff;
    margin: 0;
    padding: 0;
    line-height: 1.5;
    background-image: none;
  }

  /* ── Header ── */
  .site-header {
    background: var(--blue);
    color: #fff;
  }

  .header-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .brand {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .site-title {
    font-size: 18px;
    font-weight: 700;
    color: #fff;
    letter-spacing: -0.01em;
  }

  .site-subtitle {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.7);
  }

  .admin-btn {
    font-size: 13px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.9);
    text-decoration: none;
    padding: 7px 16px;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: var(--radius-pill);
    transition: background 150ms;
    white-space: nowrap;
  }

  .admin-btn:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  /* ── Main layout ── */
  .page-shell {
    max-width: 1100px;
    margin: 0 auto;
    padding: 24px 24px 48px;
  }

  /* ── Filter bar ── */
  .filter-bar {
    display: flex;
    gap: 16px;
    align-items: center;
    background: #fff;
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
    padding: 16px 24px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }

  .search-input {
    flex: 1;
    min-width: 200px;
    height: 40px;
    padding: 0 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font: inherit;
    font-size: 14px;
    color: var(--text);
    background: #fff;
    transition: border-color 150ms, box-shadow 150ms;
  }

  .search-input:focus {
    outline: none;
    border-color: var(--blue);
    box-shadow: 0 0 0 3px rgba(26, 86, 219, 0.12);
  }

  .tag-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }

  .filter-pill {
    height: 44px;
    padding: 0 14px;
    border: 1px solid #d1d5db;
    border-radius: var(--radius-pill);
    background: #fff;
    color: var(--text);
    font: inherit;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: background 150ms, border-color 150ms, color 150ms;
    min-width: 44px;
    display: inline-flex;
    align-items: center;
  }

  .filter-pill:hover {
    border-color: var(--blue);
    color: var(--blue);
  }

  .filter-pill.active {
    background: var(--blue);
    border-color: var(--blue);
    color: #fff;
  }

  /* ── State boxes ── */
  .state-box {
    padding: 48px 24px;
    text-align: center;
    color: var(--muted);
    font-size: 15px;
  }

  .state-box.state-error {
    color: #dc2626;
  }

  .hidden {
    display: none !important;
  }

  .empty-icon {
    font-size: 40px;
    margin-bottom: 12px;
    line-height: 1;
  }

  .state-box p {
    margin: 0;
    color: var(--muted);
  }

  /* ── Topics container ── */
  .topics-container {
    display: grid;
    gap: 16px;
  }

  /* ── Topic section ── */
  .topic-section {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .topic-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    padding: 16px 20px;
    background: var(--blue-tint);
    border-left: 4px solid var(--blue);
    cursor: pointer;
    user-select: none;
    border-radius: var(--radius) var(--radius) 0 0;
  }

  .topic-section[data-open="false"] .topic-header {
    border-radius: var(--radius);
  }

  .topic-header-left {
    flex: 1;
    min-width: 0;
  }

  .topic-title {
    font-size: 17px;
    font-weight: 700;
    margin: 0 0 8px;
    color: var(--text);
    line-height: 1.3;
  }

  .topic-meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tag-pill {
    --tag-color: #475569;
    display: inline-flex;
    align-items: center;
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    font-size: 11px;
    font-weight: 500;
    background: color-mix(in srgb, var(--tag-color) 15%, white);
    color: var(--tag-color);
    line-height: 1.6;
  }

  .topic-date {
    font-size: 12px;
    color: var(--muted);
  }

  .topic-header-right {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .doc-count-badge {
    font-size: 13px;
    color: var(--muted);
    white-space: nowrap;
    font-weight: 500;
  }

  .collapse-icon {
    transition: transform 200ms ease;
    color: var(--muted);
    flex-shrink: 0;
  }

  .topic-section[data-open="false"] .collapse-icon {
    transform: rotate(-90deg);
  }

  /* ── Topic content ── */
  .topic-content {
    background: #fff;
    border-top: 1px solid var(--border);
  }

  .topic-section[data-open="false"] .topic-content {
    display: none;
  }

  /* ── Document rows ── */
  .doc-item:not(:last-child) {
    border-bottom: 1px solid var(--border-light);
  }

  .doc-row {
    display: grid;
    grid-template-columns: 140px 1fr auto auto;
    gap: 12px;
    align-items: center;
    padding: 10px 16px;
    background: #fff;
    transition: background 120ms;
  }

  .doc-row.row-alt {
    background: var(--bg-alt);
  }

  .doc-row:hover {
    background: var(--blue-tint);
  }

  .doc-type-badge {
    --badge-color: #475569;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    font-size: 12px;
    font-weight: 600;
    width: 130px;
    text-align: center;
    background: color-mix(in srgb, var(--badge-color) 15%, white);
    color: var(--badge-color);
    border: 1px solid color-mix(in srgb, var(--badge-color) 35%, white);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    box-sizing: border-box;
  }

  .doc-title-link {
    font-size: 14px;
    color: var(--blue);
    text-decoration: none;
    font-weight: 500;
    min-width: 0;
    overflow-wrap: break-word;
  }

  .doc-title-link:hover {
    text-decoration: underline;
  }

  .doc-size {
    font-size: 13px;
    color: var(--muted);
    text-align: right;
    min-width: 70px;
    font-variant-numeric: tabular-nums;
  }

  .pdf-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 4px 12px;
    background: #e53935;
    color: #fff;
    font-size: 12px;
    font-weight: 600;
    border-radius: var(--radius-sm);
    text-decoration: none;
    white-space: nowrap;
    transition: background 120ms;
    min-height: 28px;
  }

  .pdf-btn:hover {
    background: #c62828;
  }

  .no-docs {
    padding: 16px;
    color: var(--muted);
    font-size: 14px;
    margin: 0;
  }

  /* ── Attachments ── */
  .attachment-list {
    border-left: 2px solid var(--border);
    margin-left: 20px;
  }

  .attachment-row {
    font-size: 13px;
  }

  /* ── Footer ── */
  .site-footer {
    background: var(--bg-footer);
    border-top: 1px solid var(--border);
    padding: 20px 24px;
    text-align: center;
    font-size: 14px;
    color: var(--muted);
  }

  .site-footer p {
    margin: 0;
  }

  /* ── Mobile ── */
  @media (max-width: 640px) {
    .header-inner {
      padding: 0 16px;
    }

    .site-subtitle {
      display: none;
    }

    .page-shell {
      padding: 16px 16px 40px;
    }

    .filter-bar {
      padding: 12px 16px;
      gap: 12px;
    }

    .search-input {
      min-width: 0;
      width: 100%;
      flex: none;
    }

    .topic-header {
      flex-direction: column;
      gap: 12px;
    }

    .topic-header-right {
      width: 100%;
      justify-content: space-between;
    }

    .doc-row {
      grid-template-columns: auto 1fr;
      grid-template-rows: auto auto;
      row-gap: 6px;
    }

    .doc-type-badge {
      grid-column: 1;
      grid-row: 1;
      width: auto;
      max-width: 140px;
    }

    .pdf-btn {
      grid-column: 2;
      grid-row: 1;
      justify-self: end;
    }

    .doc-title-link {
      grid-column: 1 / -1;
      grid-row: 2;
    }

    .doc-size {
      display: none;
    }
  }
</style>
