---
export const prerender = false;
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="hu">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main class="page-shell">
      <section class="hero">
        <div>
          <p class="eyebrow">Nyilvános dokumentumtár</p>
          <h1>Dokumentumok és mellékletek</h1>
          <p>Témakörök szerint rendezett, kereshető dokumentumlista.</p>
        </div>
        <a href="/admin" class="admin-link">Admin felület</a>
      </section>

      <section class="filters">
        <label class="search-box">
          <span>Keresés</span>
          <input type="search" id="searchInput" placeholder="Keresés dokumentum címe szerint…" />
        </label>
        <div>
          <p class="filter-label">Címkék</p>
          <div id="tagFilters" class="tag-filters"></div>
        </div>
      </section>

      <div id="loadingState" class="state-box">Témák betöltése…</div>
      <div id="errorState" class="state-box error hidden">Hiba történt a dokumentumok betöltésekor.</div>
      <div id="emptyState" class="state-box hidden">Nincs a szűrésnek megfelelő dokumentum.</div>
      <section id="topicsContainer" class="topics"></section>
    </main>
    <Footer />
  </body>
</html>

<script>
  interface Tag {
    id: number;
    name: string;
    slug: string;
    color: string | null;
    sort_order: number;
  }

  interface DocumentType {
    id: number;
    name: string;
    slug: string;
    color: string | null;
    sort_order: number;
  }

  interface Document {
    id: number;
    topic_id: number;
    parent_id: number | null;
    document_type_id: number;
    title: string;
    reference_no: string | null;
    r2_key: string;
    file_name: string;
    file_size: number;
    mime_type: string;
    sort_order: number;
    is_active: number;
    created_at: string;
    document_type?: DocumentType;
    attachments?: Document[];
  }

  interface Topic {
    id: number;
    title: string;
    event_date: string | null;
    document_count: number | null;
    sort_order: number;
    is_public: number;
    created_at: string;
    updated_at: string;
    tags?: Tag[];
    documents?: Document[];
  }

  const loadingStateEl = document.getElementById('loadingState') as HTMLDivElement;
  const errorStateEl = document.getElementById('errorState') as HTMLDivElement;
  const emptyStateEl = document.getElementById('emptyState') as HTMLDivElement;
  const topicsContainerEl = document.getElementById('topicsContainer') as HTMLElement;
  const tagFiltersEl = document.getElementById('tagFilters') as HTMLDivElement;
  const searchInputEl = document.getElementById('searchInput') as HTMLInputElement;

  let topics: Topic[] = [];
  let activeTagSlug = '';

  function escapeHtml(value: string): string {
    return value
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function formatDate(value: string | null): string {
    if (!value) return 'Nincs esemény dátum';
    return new Date(value).toLocaleString('hu-HU', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
    });
  }

  function formatSize(bytes: number): string {
    if (bytes < 1024) return `${bytes} B`;
    if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
    return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
  }

  function renderBadge(label: string, color: string | null, className = 'badge'): string {
    const style = color ? ` style="--badge-color:${escapeHtml(color)}"` : '';
    return `<span class="${className}"${style}>${escapeHtml(label)}</span>`;
  }

  function matchesSearch(topic: Topic, searchValue: string): boolean {
    if (!searchValue) {
      return true;
    }

    return (topic.documents ?? []).some((document) => {
      const inDocument = document.title.toLowerCase().includes(searchValue);
      const inAttachment = (document.attachments ?? []).some((attachment) => attachment.title.toLowerCase().includes(searchValue));
      return inDocument || inAttachment;
    });
  }

  function renderDocumentList(documents: Document[], level = 0): string {
    if (documents.length === 0) {
      return '<p class="muted">Ehhez a témához jelenleg nincs aktív dokumentum.</p>';
    }

    return documents.map((document) => {
      const attachments = document.attachments && document.attachments.length > 0
        ? `<div class="attachment-list">${renderDocumentList(document.attachments, level + 1)}</div>`
        : '';
      const downloadPath = `/api/download/${document.r2_key.split('/').map(encodeURIComponent).join('/')}`;
      return `<article class="document-card${level > 0 ? ' attachment-card' : ''}">
        <div>
          <div class="document-topline">
            ${document.document_type ? renderBadge(document.document_type.name, document.document_type.color) : ''}
            <strong>${escapeHtml(document.title)}</strong>
          </div>
          <p class="muted meta-row">
            ${escapeHtml(formatSize(document.file_size))}
            ${document.reference_no ? ` · Iktatószám: ${escapeHtml(document.reference_no)}` : ''}
          </p>
        </div>
        <a href="${downloadPath}" class="download-link" download>Letöltés</a>
        ${attachments}
      </article>`;
    }).join('');
  }

  function renderTagFilters(): void {
    const tagsBySlug = new Map<string, Tag>();
    topics.forEach((topic) => {
      (topic.tags ?? []).forEach((tag) => tagsBySlug.set(tag.slug, tag));
    });

    const tags = Array.from(tagsBySlug.values()).sort((left, right) => left.sort_order - right.sort_order || left.name.localeCompare(right.name, 'hu'));

    tagFiltersEl.innerHTML = [
      `<button type="button" class="filter-chip${activeTagSlug === '' ? ' active' : ''}" data-tag="">Összes</button>`,
      ...tags.map((tag) => `<button type="button" class="filter-chip${activeTagSlug === tag.slug ? ' active' : ''}" data-tag="${escapeHtml(tag.slug)}">${renderBadge(tag.name, tag.color, 'badge tag-badge')}</button>`),
    ].join('');

    tagFiltersEl.querySelectorAll<HTMLButtonElement>('.filter-chip').forEach((button) => {
      button.addEventListener('click', () => {
        activeTagSlug = button.dataset.tag ?? '';
        renderTagFilters();
        renderTopics();
      });
    });
  }

  function renderTopics(): void {
    const searchValue = searchInputEl.value.trim().toLowerCase();
    const filteredTopics = topics.filter((topic) => {
      const matchesTag = !activeTagSlug || (topic.tags ?? []).some((tag) => tag.slug === activeTagSlug);
      return matchesTag && matchesSearch(topic, searchValue);
    });

    emptyStateEl.classList.toggle('hidden', filteredTopics.length > 0);
    topicsContainerEl.innerHTML = filteredTopics.map((topic) => {
      const badges = (topic.tags ?? []).map((tag) => renderBadge(tag.name, tag.color, 'badge tag-badge')).join('');
      return `<details class="topic-card" ${searchValue || activeTagSlug ? 'open' : ''}>
        <summary>
          <div>
            <h2>${escapeHtml(topic.title)}</h2>
            <p class="muted">${escapeHtml(formatDate(topic.event_date))}</p>
          </div>
          <div class="summary-side">
            <div class="tag-row">${badges}</div>
            <span class="count-pill">${topic.document_count ?? topic.documents?.length ?? 0} dokumentum</span>
          </div>
        </summary>
        <div class="topic-content">
          ${renderDocumentList(topic.documents ?? [])}
        </div>
      </details>`;
    }).join('');
  }

  async function fetchJson<T>(url: string): Promise<T> {
    const response = await fetch(url);
    if (!response.ok) {
      throw new Error(`HTTP ${response.status}`);
    }
    return response.json() as Promise<T>;
  }

  async function loadTopics(): Promise<void> {
    const topicSummaries = await fetchJson<Topic[]>('/api/topics');
    topics = await Promise.all(
      topicSummaries.map((topic) => fetchJson<Topic>(`/api/topics/${topic.id}`)),
    );
    renderTagFilters();
    renderTopics();
    loadingStateEl.classList.add('hidden');
  }

  searchInputEl.addEventListener('input', () => {
    renderTopics();
  });

  void loadTopics().catch(() => {
    loadingStateEl.classList.add('hidden');
    errorStateEl.classList.remove('hidden');
  });
</script>

<style>
  .page-shell {
    max-width: 1100px;
    margin: 0 auto;
    padding: 1.5rem 1rem 3rem;
  }

  .hero,
  .filters,
  .topic-card {
    background: #fff;
    border: 1px solid #d8deea;
    border-radius: 1rem;
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.04);
  }

  .hero,
  .filters {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.25rem;
    margin-bottom: 1rem;
  }

  .eyebrow,
  .filter-label,
  .muted {
    color: #5f6b7c;
  }

  .eyebrow,
  .filter-label {
    margin: 0 0 0.4rem;
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .hero h1,
  .topic-card h2 {
    margin: 0;
  }

  .hero p,
  .topic-card p,
  .meta-row {
    margin: 0.35rem 0 0;
  }

  .admin-link,
  .download-link,
  .filter-chip,
  .count-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    font-weight: 700;
    text-decoration: none;
  }

  .admin-link,
  .download-link,
  .filter-chip {
    padding: 0.7rem 1rem;
    border: none;
    background: #1d4ed8;
    color: #fff;
    cursor: pointer;
  }

  .search-box {
    display: grid;
    gap: 0.4rem;
    flex: 1;
  }

  .search-box input {
    width: 100%;
    padding: 0.8rem 0.95rem;
    border-radius: 0.85rem;
    border: 1px solid #cbd5e1;
    font: inherit;
  }

  .tag-filters,
  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .filter-chip {
    background: #e2e8f0;
    color: #1e293b;
    padding: 0.2rem;
  }

  .filter-chip.active {
    background: #1d4ed8;
    color: #fff;
  }

  .badge {
    --badge-color: #475569;
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--badge-color) 14%, white);
    color: var(--badge-color);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .topics {
    display: grid;
    gap: 1rem;
  }

  .topic-card summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem;
    cursor: pointer;
  }

  .topic-card summary::-webkit-details-marker {
    display: none;
  }

  .summary-side {
    display: grid;
    gap: 0.75rem;
    justify-items: end;
  }

  .count-pill {
    padding: 0.35rem 0.8rem;
    background: #eef2ff;
    color: #4338ca;
  }

  .topic-content {
    padding: 0 1.25rem 1.25rem;
    display: grid;
    gap: 0.85rem;
  }

  .document-card {
    display: grid;
    gap: 0.75rem;
    padding: 1rem;
    border: 1px solid #e2e8f0;
    border-radius: 0.9rem;
  }

  .document-topline {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .attachment-list {
    display: grid;
    gap: 0.65rem;
    padding-left: 1rem;
    border-left: 2px solid #dbe4ff;
  }

  .attachment-card {
    background: #f8fbff;
  }

  .state-box {
    padding: 1rem;
    text-align: center;
    color: #5f6b7c;
  }

  .state-box.error {
    color: #b91c1c;
  }

  .hidden {
    display: none;
  }

  @media (max-width: 760px) {
    .hero,
    .filters,
    .topic-card summary {
      flex-direction: column;
      align-items: flex-start;
    }

    .summary-side {
      justify-items: start;
    }
  }
</style>
