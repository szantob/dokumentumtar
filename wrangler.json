{
	"name": "dokumentumtar",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./dist/_worker.js/index.js",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_id": "db75c0a7-cd3f-47be-a7fe-1a0e232008a5",
			"database_name": "dokumentumtar"
		}
	],
	"r2_buckets": [
		{
			"binding": "DOKUMENTUMTAR",
			"bucket_name": "dokumentumtar"
		}
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
